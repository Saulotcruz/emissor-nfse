# Copie para .env e preencha. NUNCA versione o .env.

# --- Banco ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=nfse
DB_PASS=
DB_NAME=nfse_emissor

# --- App ---
PORT=3100
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
COOKIE_SECURE=0

# Usados só pelo `npm run seed`, para criar o primeiro admin.
ADMIN_EMAIL=
ADMIN_SENHA=

# --- Certificado A1 ---
# O .pfx fica no disco com permissão restrita (chmod 600). Nunca no banco, nunca no Git.
NFSE_CERT_PATH=/opt/nfse/certs/certificado.pfx
NFSE_CERT_PASSWORD=

# --- Ambiente fiscal ---
# producao-restrita = homologação real (sem efeito fiscal) | producao = valendo
NFSE_AMBIENTE=producao-restrita

# --- Emitente (prestador) ---
# Lidos pelo `npm run seed`. Os três primeiros são obrigatórios.
EMITENTE_CNPJ=
EMITENTE_RAZAO_SOCIAL=
EMITENTE_CODIGO_MUNICIPIO=          # IBGE de 7 dígitos, ex.: 3106200
EMITENTE_NOME_FANTASIA=
EMITENTE_INSCRICAO_MUNICIPAL=       # opcional no Portal Nacional
EMITENTE_CNAE=                      # 7 dígitos sem pontuação, ex.: 6202300
EMITENTE_REGIME_TRIBUTARIO=lucro_presumido   # simples_nacional | lucro_presumido | lucro_real
EMITENTE_OPTANTE_SIMPLES=0
EMITENTE_REGIME_ESPECIAL=
EMITENTE_LOGRADOURO=
EMITENTE_NUMERO=
EMITENTE_COMPLEMENTO=
EMITENTE_BAIRRO=
EMITENTE_CEP=
EMITENTE_UF=
EMITENTE_EMAIL=
EMITENTE_TELEFONE=

# Série da DPS. A faixa 1-49999 é a de emissão via WEBSERVICE — é a que este
# sistema usa. O Portal Nacional emite na faixa 70000-79999, então as duas
# numerações são independentes e não colidem.
# Convênio do município ativo no Sistema Nacional NFS-e (padrão: 1).
# Ativo => a alíquota do ISS vem da tabela do município e NÃO pode ir na DPS.
# Só mude para 0 se a SEFIN rejeitar com E0619 cobrando a alíquota.
EMITENTE_CONVENIO_ATIVO=1

EMITENTE_SERIE_DPS=1

# --- Serviço padrão ---
SERVICO_CODIGO=                     # código de tributação nacional, ex.: 010501
SERVICO_DESCRICAO=
SERVICO_NBS=
SERVICO_ALIQUOTA_ISS=          # só o número, sem % — ex.: 2
SERVICO_ISS_RETIDO=0
SERVICO_TIPO_TRIBUTACAO_ISSQN=operacao_tributavel
SERVICO_SITUACAO_PIS_COFINS=STANDARD_TAXABLE_OPERATION
SERVICO_TIPO_RETENCAO_PIS_COFINS=0  # 0 = PIS/COFINS/CSLL não retidos

# Alíquotas da OPERAÇÃO PRÓPRIA (aparecem na nota como "Débito Apuração Própria").
# Não confundir com as SERVICO_RET_*, que são retenção e reduzem o valor a receber.
SERVICO_ALIQUOTA_PIS=          # ex.: 0.65
SERVICO_ALIQUOTA_COFINS=       # ex.: 3

SERVICO_RET_PIS=0
SERVICO_RET_COFINS=0
SERVICO_RET_CSLL=0
SERVICO_RET_INSS=0
SERVICO_RET_IR=0

# --- Stripe ---
# Signing secret do endpoint de webhook (whsec_...). É a ÚNICA credencial da
# Stripe necessária: o sistema não chama a API deles, tudo que a emissão usa
# vem no próprio payload do webhook.
# Atenção: test mode e live mode têm endpoints e secrets DIFERENTES.
STRIPE_WEBHOOK_SECRET=

# --- Alertas por e-mail ---
# Com Gmail, SMTP_PASS precisa ser uma SENHA DE APP (16 caracteres), não a senha
# da conta: myaccount.google.com > Segurança > Verificação em duas etapas >
# Senhas de app. Exige 2FA ativado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERTA_EMAIL_DE=            # vazio = usa o SMTP_USER
# Aceita vários, separados por vírgula. Prefira endereçar as pessoas
# diretamente a usar um alias de grupo: o Google Groups não devolve a
# mensagem ao próprio autor, então quem envia não recebe o alerta.
ALERTA_EMAIL_PARA=

# Avisa quando o certificado estiver a este número de dias do vencimento
ALERTA_DIAS_CERTIFICADO=30
# Nota parada sem envio por mais que isto vira alerta
ALERTA_HORAS_PENDENTE=2

# --- Integrações ---
BRASILAPI_USER_AGENT=
